# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Data: keep large/raw scientific data out of Git
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/features/*
!data/features/.gitkeep

# Generated outputs and model files
outputs/
models/
*.joblib
*.pkl
*.h5
*.nc
*.grib
*.tif
*.tiff
*.parquet

# Logs and temporary files
logs/*
!logs/.gitkeep
*.log
*.tmp

# Secrets
*.token
*credentials*
*secret*
